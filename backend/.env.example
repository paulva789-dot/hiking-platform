# ---- Server -------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL) ---------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trek_cameroon?schema=public"

# ---- Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- Weather (https://openweathermap.org/api) --------------------------
OPENWEATHER_API_KEY=

# ---- Image storage (https://cloudinary.com) ----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trek-cameroon

# ---- Business rules ----------------------------------------------------
# Platform commission taken on every tour booking (percent)
BOOKING_COMMISSION_PCT=12
# Commission taken on photography marketplace sales (percent)
PHOTO_COMMISSION_PCT=20

# ---- Seed admin account -------------------------------------------------
SEED_ADMIN_EMAIL=admin@trekcameroon.cm
SEED_ADMIN_PASSWORD=Admin@12345
