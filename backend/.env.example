# ---- Server -------------------------------------------------------------
# Port 4001, not the usual 4000 — see the note in backend/.env.
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL) ---------------------------------------------
# Port 5433, not the Postgres default 5432 — see docker-compose.yml; this
# avoids clashing with another local Postgres instance already using 5432.
# If nothing else on your machine uses 5432, feel free to switch both back.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/trek_cameroon?schema=public"

# ---- Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- Weather (https://openweathermap.org/api) --------------------------
OPENWEATHER_API_KEY=

# ---- Image storage (https://cloudinary.com) ----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trek-cameroon

# ---- Payments: MTN Mobile Money / Orange Money ---------------------------
# Flutterwave (https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Set the same value in the Flutterwave dashboard webhook config — used to
# verify the "verif-hash" header on incoming webhooks.
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Intouch (direct MTN MoMo / Orange Money collection aggregator)
INTOUCH_LOGIN_API=
INTOUCH_PASSWORD_API=
INTOUCH_PARTNER_ID=
INTOUCH_BASE_URL=https://api.intouchpay.co/api
INTOUCH_CALLBACK_SECRET=

# ---- Business rules ----------------------------------------------------
# Platform commission taken on every tour booking (percent)
BOOKING_COMMISSION_PCT=12
# Commission taken on photography marketplace sales (percent)
PHOTO_COMMISSION_PCT=20

# ---- Seed admin account -------------------------------------------------
SEED_ADMIN_EMAIL=admin@trekcameroon.cm
SEED_ADMIN_PASSWORD=Admin@12345
