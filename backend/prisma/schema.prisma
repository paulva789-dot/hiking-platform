// Travesía Cameroon — Prisma schema
// Database: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is the query engine Vercel's
  // Node.js serverless runtime (Amazon Linux 2023) needs at deploy time.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  USER
  GUIDE
  ADMIN
}

enum Region {
  ADAMAWA
  CENTRE
  EAST
  FAR_NORTH
  LITTORAL
  NORTH
  NORTH_WEST
  SOUTH
  SOUTH_WEST
  WEST
}

enum Difficulty {
  EASY
  MODERATE
  HARD
  EXPERT
}

/**
 * What kind of place the trail actually is — drives the map marker glyph.
 */
enum TrailCategory {
  SUMMIT
  WATERFALL
  LAKE
  FOREST
  WILDLIFE
  COASTAL
  CULTURAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  /**
   * A paid booking was cancelled but the automatic refund call failed or
   * isn't supported for that payment's provider -- needs a human to
   * actually send the money back, rather than the UI silently claiming
   * REFUNDED when nothing moved.
   */
  REFUND_PENDING
}

enum MembershipTier {
  FREE
  PREMIUM
}

/**
 * Self-declared at signup or in profile settings -- drives Premium's
 * segment pricing (see backend/src/lib/pricing.js). Not detected via
 * geolocation or any other inference; LOCAL is the default so nobody who
 * skips the question is silently charged the higher tier.
 */
enum TravelerSegment {
  LOCAL
  INTERNATIONAL
}

enum GuidePlan {
  NONE
  BASIC
  PRO
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ListingKind {
  ACCOMMODATION
  EQUIPMENT
}

/**
 * What kind of place an ACCOMMODATION listing actually is — drives the
 * "what to book near this trail" suggestion (a remote wilderness trail
 * should lead with a campsite, not a spa hotel). Not set on EQUIPMENT.
 */
enum AccommodationType {
  CAMPSITE
  GUESTHOUSE
  LODGE
  HOMESTAY
  HOTEL
}

enum PaymentProvider {
  FLUTTERWAVE
  INTOUCH
}

enum PaymentMethod {
  MTN_MOMO
  ORANGE_MONEY
}

enum PaymentPurpose {
  PREMIUM_MEMBERSHIP
  GUIDE_PLAN
  BOOKING
}

/**
 * Named PaymentAttemptStatus, not PaymentStatus, to avoid colliding with the existing booking PaymentStatus enum.
 */
enum PaymentAttemptStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

// ---------------------------------------------------------------- users

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  name            String
  role            Role            @default(USER)
  avatarUrl       String?
  bio             String?
  phone           String?
  region          Region?
  tier            MembershipTier  @default(FREE)
  tierExpires     DateTime?
  travelerSegment TravelerSegment @default(LOCAL)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  guideProfile GuideProfile?
  reviews      Review[]
  favorites    Favorite[]
  photos       Photo[]
  bookings     Booking[]
  groups       GroupMember[]
  ownedGroups  HikingGroup[]   @relation("GroupOwner")
  tickets      EventTicket[]
  payments     Payment[]
  checkIns     SafetyCheckIn[]

  @@index([role])
}

model GuideProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String
  bio             String
  yearsExperience Int            @default(0)
  languages       String[]       @default([])
  certifications  String[]       @default([])
  regions         Region[]       @default([])
  /**
   * Central African countries this guide runs tours in — booking is not limited to Cameroon.
   */
  countries       String[]       @default(["Cameroon"])
  dayRateXAF      Int            @default(0)
  phone           String?
  whatsapp        String?
  status          ApprovalStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNote      String?
  plan            GuidePlan      @default(NONE)
  planExpires     DateTime?
  ratingAvg       Float          @default(0)
  ratingCount     Int            @default(0)
  /**
   * Guide toolkit: how many times the public profile has been viewed --
   * paired with booking count in the dashboard as a rough lead-conversion
   * signal, the same way Trail.viewCount already works for hikers.
   */
  profileViews    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tours Tour[]

  @@index([status])
}

// ---------------------------------------------------------------- trails

model Trail {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  summary         String
  description     String
  region          Region
  nearestTown     String
  difficulty      Difficulty
  category        TrailCategory @default(FOREST)
  distanceKm      Float
  elevationGainM  Int
  durationMinutes Int
  summitM         Int?
  startLat        Float
  startLng        Float
  // GeoJSON LineString of the route, drawn on the Leaflet map
  routeGeoJson    Json?
  bestMonths      String[]      @default([])
  hazards         String[]      @default([])
  waterSources    String?
  permitRequired  Boolean       @default(false)
  permitInfo      String?
  gettingThere    String?
  coverImage      String?
  published       Boolean       @default(true)
  ratingAvg       Float         @default(0)
  ratingCount     Int           @default(0)
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  waypoints    Waypoint[]
  reviews      Review[]
  favorites    Favorite[]
  photos       Photo[]
  tours        Tour[]
  translations TrailTranslation[]

  @@index([region, difficulty])
  @@index([published])
}

/**
 * ISO 639-1 codes for the languages this platform's UI chrome already
 * switches between (see frontend/src/lib/i18n) -- English itself isn't a
 * row here, it lives on Trail directly and every field below falls back to
 * it when a translation is missing or incomplete.
 */
enum ContentLocale {
  FR
  ES
  PT
}

model TrailTranslation {
  id           String        @id @default(cuid())
  trailId      String
  trail        Trail         @relation(fields: [trailId], references: [id], onDelete: Cascade)
  locale       ContentLocale
  summary      String?
  description  String?
  hazards      String[]      @default([])
  waterSources String?
  permitInfo   String?
  gettingThere String?
  updatedAt    DateTime      @updatedAt

  @@unique([trailId, locale])
}

model Waypoint {
  id          String  @id @default(cuid())
  trailId     String
  trail       Trail   @relation(fields: [trailId], references: [id], onDelete: Cascade)
  name        String
  description String?
  lat         Float
  lng         Float
  elevationM  Int?
  order       Int     @default(0)

  @@index([trailId])
}

model Review {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trailId   String
  trail     Trail          @relation(fields: [trailId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  body      String
  hikedOn   DateTime?
  status    ApprovalStatus @default(APPROVED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, trailId])
  @@index([trailId, status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trailId   String
  trail     Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trailId])
  @@index([userId])
}

// ---------------------------------------------------------------- gallery / photo marketplace

model Photo {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trailId    String?
  trail      Trail?         @relation(fields: [trailId], references: [id], onDelete: SetNull)
  url        String
  publicId   String
  width      Int?
  height     Int?
  caption    String?
  takenAt    DateTime?
  status     ApprovalStatus @default(PENDING)
  // photography marketplace
  forSale    Boolean        @default(false)
  priceXAF   Int?
  licence    String?
  salesCount Int            @default(0)
  createdAt  DateTime       @default(now())

  @@index([status, createdAt])
  @@index([trailId])
}

// ---------------------------------------------------------------- tours & bookings

model Tour {
  id           String       @id @default(cuid())
  guideId      String
  guide        GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  trailId      String?
  trail        Trail?       @relation(fields: [trailId], references: [id], onDelete: SetNull)
  title        String
  description  String
  /**
   * Which CEMAC country this specific tour runs in — a guide's tours aren't all in the same one.
   */
  country      String       @default("Cameroon")
  priceXAF     Int
  maxGroupSize Int          @default(8)
  durationDays Int          @default(1)
  includes     String[]     @default([])
  excludes     String[]     @default([])
  meetingPoint String?
  published    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  schedules TourSchedule[]
  bookings  Booking[]

  @@index([guideId])
}

model TourSchedule {
  id          String   @id @default(cuid())
  tourId      String
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  capacity    Int
  seatsBooked Int      @default(0)
  cancelled   Boolean  @default(false)

  bookings Booking[]

  @@index([tourId, startDate])
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId        String
  tour          Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  scheduleId    String
  schedule      TourSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  participants  Int           @default(1)
  subtotalXAF   Int
  commissionXAF Int
  totalXAF      Int
  /**
   * What's actually charged via MTN MoMo / Orange Money at booking time --
   * the rest (balanceDueXAF) is paid in cash to the guide at the trailhead.
   * commissionXAF always fits inside depositXAF (see booking.routes.js), so
   * the platform's full cut clears the moment the deposit does.
   */
  depositXAF    Int           @default(0)
  balanceDueXAF Int           @default(0)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  contactPhone  String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Not one-to-one: a failed attempt can be retried, so a booking may have
  // more than one Payment row over time (at most one PENDING at a time).
  payments Payment[]

  @@index([userId])
  @@index([tourId, status])
}

// ---------------------------------------------------------------- payments (MTN MoMo / Orange Money)

/**
 * One record per checkout attempt against Flutterwave or Intouch: a Premium
 * membership purchase, a guide plan purchase, or a tour booking. The
 * webhook/callback handlers flip status to SUCCESSFUL and grant the
 * entitlement (or confirm the booking) idempotently.
 */
model Payment {
  id            String               @id @default(cuid())
  reference     String               @unique
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  method        PaymentMethod
  purpose       PaymentPurpose
  phone         String
  amountXAF     Int
  // PREMIUM_MEMBERSHIP
  months        Int?
  // GUIDE_PLAN
  guidePlan     GuidePlan?
  // BOOKING -- deliberately not @unique: a failed attempt must not block
  // retrying, so at most one PENDING payment per booking is enforced in
  // code (payment.routes.js), not by a DB constraint.
  bookingId     String?
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status        PaymentAttemptStatus @default(PENDING)
  providerRef   String?
  failureReason String?
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------- community

model HikingGroup {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  region      Region?
  coverImage  String?
  ownerId     String
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  members GroupMember[]
}

model GroupMember {
  id       String          @id @default(cuid())
  groupId  String
  group    HikingGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
}

// ---------------------------------------------------------------- safety content (CMS)

model SafetyGuideline {
  id        String   @id @default(cuid())
  category  String
  title     String
  body      String
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

/**
 * Premium perk: "I'm heading out, alert my contact if I'm not back by X."
 * A background sweep (safety-sweep.js) flips ACTIVE rows past dueBackAt to
 * OVERDUE and SMS's the emergency contact via Africa's Talking (sms.js).
 */
enum CheckInStatus {
  ACTIVE
  CHECKED_IN
  OVERDUE
  ALERTED
  CANCELLED
}

model SafetyCheckIn {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Free text, not a Trail relation -- covers routes and variants that
   * aren't in the trail catalogue at all.
   */
  planLabel             String
  emergencyContactName  String
  emergencyContactPhone String
  dueBackAt             DateTime
  status                CheckInStatus @default(ACTIVE)
  checkedInAt           DateTime?
  alertedAt             DateTime?
  alertFailureReason    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, dueBackAt])
  @@index([userId])
}

// ---------------------------------------------------------------- monetization: partners, gear, events, ads

model Listing {
  id                String             @id @default(cuid())
  kind              ListingKind
  accommodationType AccommodationType?
  name              String
  description       String
  imageUrl          String?
  region            Region?
  town              String?
  priceFromXAF      Int?
  affiliateUrl      String
  partnerName       String?
  commissionPct     Float              @default(10)
  featured          Boolean            @default(false)
  published         Boolean            @default(true)
  clickCount        Int                @default(0)
  createdAt         DateTime           @default(now())

  @@index([kind, published])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  region      Region?
  location    String
  startDate   DateTime
  endDate     DateTime
  priceXAF    Int      @default(0)
  capacity    Int
  ticketsSold Int      @default(0)
  coverImage  String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  tickets EventTicket[]
}

model EventTicket {
  id            String        @id @default(cuid())
  reference     String        @unique
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity      Int           @default(1)
  totalXAF      Int
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())

  @@index([eventId])
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/**
 * Demand-side lead capture for groups larger than a single Tour's
 * maxGroupSize, or a custom/corporate itinerary -- no account required to
 * submit, since a company contact may not want to register just to ask.
 */
model GroupInquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  organization    String?
  groupSize       Int
  preferredRegion Region?
  message         String
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}

model AdSlot {
  id          String    @id @default(cuid())
  placement   String
  advertiser  String
  imageUrl    String
  targetUrl   String
  weight      Int       @default(1)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  active      Boolean   @default(true)

  @@index([placement, active])
}
